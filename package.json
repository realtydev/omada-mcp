{
    "name": "@realtydev/omada-mcp",
    "version": "0.6.1",
    "description": "Full read/write Model Context Protocol server for TP-Link Omada SDN controllers — sites, devices, clients, VLANs, firewall, switch ports, Wi-Fi and WAN",
    "type": "module",
    "main": "dist/index.js",
    "bin": "./dist/index.js",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/realtydev/omada-mcp.git"
    },
    "homepage": "https://github.com/realtydev/omada-mcp#readme",
    "bugs": {
        "url": "https://github.com/realtydev/omada-mcp/issues"
    },
    "author": "Alex Gibson <alex@algib.com> (https://github.com/realtydev)",
    "license": "MIT",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "tp-link",
        "omada",
        "omada-sdn",
        "network-automation",
        "claude",
        "ai-agents"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "generate:build-info": "node scripts/generate-build-info.mjs",
        "build": "yarn generate:build-info && tsc -p tsconfig.json",
        "lint": "biome check --error-on-warnings .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "check": "yarn generate:build-info && yarn lint && tsc --noEmit",
        "test": "yarn generate:build-info && vitest run",
        "test:watch": "yarn generate:build-info && vitest",
        "test:coverage": "yarn generate:build-info && vitest run --coverage",
        "dev": "yarn generate:build-info && tsx src/index.ts",
        "wan-guard": "node dist/wanGuard.js",
        "start": "node dist/index.js",
        "docker:build": "docker build -f Dockerfile -t ghcr.io/realtydev/omada-mcp:latest .",
        "docker:run": "docker run --rm -it --env-file .env --env-file .env.local ghcr.io/realtydev/omada-mcp:latest",
        "docker:push": "docker push ghcr.io/realtydev/omada-mcp:latest"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.1",
        "@ngrok/ngrok": "^1.5.2",
        "axios": "^1.13.2",
        "dotenv": "^18.0.2",
        "pino": "^10.1.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@types/node": "^26.6.2",
        "@vitest/coverage-v8": "^5.0.1",
        "@vitest/ui": "^5.0.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    },
    "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
