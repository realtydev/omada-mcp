# ==============================================================================
# Omada Client Configuration
# ==============================================================================

# Base URL of the Omada controller (required)
# Example: https://omada-controller.local
OMADA_BASE_URL=https://controller.example.com:8043

# Authentication mode: oauth for classic OpenAPI credentials, web for Fusion gateways
# OMADA_AUTH_MODE=oauth

# OAuth client credentials (required when OMADA_AUTH_MODE=oauth)
# Generate these under Omada Platform Integration
OMADA_CLIENT_ID=your-client-id
OMADA_CLIENT_SECRET=your-client-secret

# Omada controller ID (omadacId) to target (required)
# Shown in the application details
OMADA_OMADAC_ID=your-omadac-id

# Optional separate MSP route ID and OAuth credential principal
# Never inferred from the controller ID
# OMADA_MSP_ID=your-msp-id
# OMADA_AUTH_ID=your-credential-principal-id

# File transfers are disabled until an existing private directory is configured
# Must be accessible to the server process; Docker uses container paths
# OMADA_TRANSFER_DIR=/absolute/path/to/transfers
# Combined upload file bytes / maximum download size (default 16 MiB, maximum 64 MiB)
# OMADA_MAX_TRANSFER_BYTES=16777216

# Optional default site ID
# If omitted, each MCP call must pass a siteId argument
# OMADA_SITE_ID=optional-default-site

# Optional web UI credentials for internal API access and Fusion web auth
# These are the same credentials used to log into the Omada web interface
# OMADA_WEB_USERNAME=admin
# OMADA_WEB_PASSWORD=your-web-password

# Enforce strict SSL certificate validation (default: true)
# Set to false to accept self-signed certificates during development
# OMADA_STRICT_SSL=true

# Optional PEM CA certificate/bundle for a controller using a private CA
# Keeps certificate and hostname verification enabled; requires strict SSL
# OMADA_CA_FILE=/absolute/path/to/controller-ca.pem

# API discovery: auto (live specification with bundled fallback), live, or bundled
# Existing purpose-built tools do not depend on discovery
# OMADA_API_SPEC=auto

# HTTP request timeout in milliseconds (default: 30000)
# OMADA_TIMEOUT=30000

# ==============================================================================
# Optional WAN Failover Guard
# ==============================================================================

# Disconnects the exact primary WAN port after consecutive observations of a
# configured modem fallback lease. Recovery remains manual, matching Omada's
# "Link Backup" recovery mode and avoiding disruptive probe reconnects.
# OMADA_WAN_GUARD_ENABLED=false
# OMADA_WAN_GUARD_DRY_RUN=true
# OMADA_WAN_GUARD_GATEWAY_MAC=AA-BB-CC-DD-EE-FF
# OMADA_WAN_GUARD_PRIMARY_PORT=2
# OMADA_WAN_GUARD_FALLBACK_CIDRS=192.168.100.0/24
# OMADA_WAN_GUARD_INTERVAL_MS=5000
# OMADA_WAN_GUARD_FAILURE_THRESHOLD=2

# ==============================================================================
# MCP Generic Server Configuration
# ==============================================================================

# Logging verbosity (default: info)
# Options: debug, info, warn, error, silent
# MCP_SERVER_LOG_LEVEL=info

# Log output format (default: plain)
# Options: plain, json, gcp-json
#   - plain: human-readable text format
#   - json: structured JSON format
#   - gcp-json: structured JSON format compatible with Google Cloud Logging
# MCP_SERVER_LOG_FORMAT=plain

# Start HTTP server instead of stdio (default: false)
# MCP_SERVER_USE_HTTP=false

# Tool exposure: full (default) or read-only (excludes writes and genericApiCall)
# MCP_TOOL_PROFILE=full
# Optional category scopes: read known categories, allow only wireless writes.
# MCP_TOOL_CATEGORIES=all:r,wireless:rw

# Maintain stateful sessions per client (default: false)
# MCP_SERVER_STATEFUL=false

# ==============================================================================
# MCP Server HTTP Configuration
# (Only used when MCP_SERVER_USE_HTTP=true)
# ==============================================================================

# Stateful/SSE session lifetime and admission limits
# Active tool calls are protected; idle event streams alone do not extend lifetime.
# MCP_HTTP_SESSION_IDLE_TIMEOUT_MS=1800000
# MCP_HTTP_MAX_SESSIONS=100

# Port for the HTTP server (default: 3000)
# MCP_HTTP_PORT=3000

# Transport protocol to use (default: stream)
# Options: stream (Streamable HTTP - MCP 2025-03-26), sse (HTTP+SSE - MCP 2024-11-05)
# MCP_HTTP_TRANSPORT=stream

# Bind address for the HTTP server (default: 127.0.0.1)
# For security, defaults to localhost. Use 0.0.0.0 to bind to all interfaces.
# IMPORTANT: Binding to 0.0.0.0 exposes the server to your network
# MCP_HTTP_BIND_ADDR=127.0.0.1

# Base path for MCP HTTP endpoints
# Default: /mcp for stream transport, /sse for sse transport
# If explicitly set, this path will be used regardless of transport type
# MCP_HTTP_PATH=/mcp

# Enable a healthcheck endpoint (default: true)
# MCP_HTTP_ENABLE_HEALTHCHECK=true

# Path for the healthcheck endpoint (default: /healthz)
# MCP_HTTP_HEALTHCHECK_PATH=/healthz

# Enable CORS for the HTTP server (default: true)
# MCP_HTTP_ALLOW_CORS=true

# Comma-separated list of allowed origins for DNS rebinding protection (default: 127.0.0.1, localhost)
# Must contain valid hostnames, IPv4, IPv6 addresses, or '*' to allow all origins
# Use '*' to allow all origins (WARNING: only for development, not recommended for production)
# Examples: localhost, 127.0.0.1, ::1, example.com, *
# MCP_HTTP_ALLOWED_ORIGINS=127.0.0.1,localhost
# MCP_HTTP_ALLOWED_ORIGINS=*

# Use ngrok to expose the HTTP server publicly (default: false)
# MCP_HTTP_NGROK_ENABLED=false

# Ngrok auth token (required if MCP_HTTP_NGROK_ENABLED=true)
# MCP_HTTP_NGROK_AUTH_TOKEN=your-ngrok-auth-token
